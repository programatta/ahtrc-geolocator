FROM debian:trixie-slim

# creamos el directorio de trabajo en el contenedor, que estará mapeado con el host.
RUN mkdir /code

# añadimos las dependencias.
# Sin libpq-dev: el proyecto usa psycopg2-binary, que trae su propio libpq
# precompilado (no hace falta pg_config/cabeceras para compilar nada).
# libgdal36/libgeos-c1t64 (no gdal-bin/geos-bin): Django/GeoDjango solo
# necesita las librerías compartidas via ctypes, no las herramientas de línea
# de comandos (ogr2ogr, gdalinfo...) que no se usan en el proyecto. gdal-bin
# arrastra python3-gdal -> numpy -> build-essential/gcc/g++ (~450MB y un pico
# de RAM en la instalación de más); con --no-install-recommends de propina.
# Limpiamos el índice de apt en la misma capa para que no infle la imagen.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libgdal36 libgeos-c1t64 \
    gettext \
    && rm -rf /var/lib/apt/lists/*

# usuario dedicado para no ejecutar la app como root (principio de mínimo
# privilegio: si Django/gunicorn/una dependencia tuviera una vulnerabilidad
# de ejecución de código, el proceso comprometido no tendría privilegios de
# root dentro del contenedor). setpriv (paquete util-linux) ya viene en la
# imagen base, así que no hace falta instalar gosu/su-exec para el entrypoint.
RUN useradd -r -m -d /home/ahtrc -s /usr/sbin/nologin ahtrc

# copiamos requirements.txt.
COPY requirements.txt /code
COPY /requirements /code/requirements

# creamos el entorno para evitar warnings.
# chown al final: el venv se crea como root (COPY --chown de más abajo no lo
# cubre, no viene del contexto de build) y "compilemessages" recorre también
# las traducciones de las apps de Django instaladas ahí dentro (contrib.auth,
# etc.), así que ahtrc necesita poder escribir esos .mo.
RUN python3 -m venv /code/.venv \
    && . /code/.venv/bin/activate \
    # instalamos las dependencias (incluye stubs de tipos para el editor).
    && pip3 install -r /code/requirements/production.txt \
    && chown -R ahtrc:ahtrc /code/.venv

# activamos el venv para cualquier proceso (entrypoint.prod.sh incluido, que
# no lee /root/.bashrc, así que activarlo solo ahí no bastaría).
ENV PATH="/code/.venv/bin:$PATH"

# copiamos el resto del código de la aplicación (la imagen debe ser
# autocontenida), con --chown para que ahtrc pueda escribir en
# staticfiles/media/locale (collectstatic/compilemessages/subida de imágenes).
COPY --chown=ahtrc:ahtrc . /code

# establecemos el directorio de trabajo.
WORKDIR /code

# el entrypoint arranca como root (necesario para el chown de los volúmenes
# con nombre) y cede privilegios a ahtrc antes de ejecutar migrate/gunicorn;
# ver entrypoint.prod.sh.
ENTRYPOINT ["/code/entrypoint.prod.sh"]