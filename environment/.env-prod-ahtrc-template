#==============================================================================
# .env-prod-ahtrc-template
# Plantilla, sin secretos, de las variables de entorno de producción para el
# servicio ahtrc_service de docker-compose.prod.yml. Copiar a
# .env-prod-ahtrc en el servidor y rellenar con valores reales (ese fichero
# está en .gitignore/.dockerignore, no se versiona).
#==============================================================================

#------------------------------------------------------------------------------
# ahtrc_service (Django).
# En producción, este valor DEBE ser el dominio real (el mismo que DOMAIN,
# más cualquier otro host por el que se acceda) o Django responde 400 Bad
# Request a toda petición: con DEBUG=False, Django rechaza cualquier Host
# que no esté en esta lista. "localhost,127.0.0.1" solo vale para desarrollo.
ALLOWED_HOSTS=
# DOMAIN también lo necesita http_service (nginx), sustituida por envsubst en
# nginx/conf.template para server_name y las rutas del certificado. Debe
# coincidir exactamente con el mismo valor de DOMAIN en .env-prod-http.
DOMAIN=
SITE_HEADER_NAME=
SITE_INDEX_TITLE=
DEBUG=False
SECRET_KEY=

ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=

# Base de datos. Deben coincidir con POSTGRES_DB/POSTGRES_USER/
# POSTGRES_PASSWORD en .env-prod-db.
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=postgres_service
DB_PORT=5432

# Opcionales, con defaults seguros en conf/settings.py (solo aplican cuando
# DEBUG=False). Tocar solo si hace falta ajustar el comportamiento HTTPS:
# SECURE_HSTS_SECONDS=86400
# SECURE_HSTS_PRELOAD=False
# SECURE_SSL_REDIRECT=True   # poner a False solo durante el bootstrap de certbot (ver runbook nginx/certbot)
