#==============================================================================
# .env-prod-db-template
# Plantilla, sin secretos, de las variables de entorno de producción para el
# servicio postgres_service de docker-compose.prod.yml. Copiar a
# .env-prod-db en el servidor y rellenar con valores reales (ese fichero
# está en .gitignore/.dockerignore, no se versiona).
#==============================================================================

#------------------------------------------------------------------------------
# postgres_service.
# Variables que usa la imagen postgis/postgis para inicializar la BD. Deben
# coincidir con DB_NAME/DB_USER/DB_PASSWORD en .env-prod-ahtrc.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
