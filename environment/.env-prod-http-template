#==============================================================================
# .env-prod-http-template
# Plantilla, sin secretos, de las variables de entorno de producción para el
# servicio http_service (nginx) de docker-compose.prod.yml. Copiar a
# .env-prod-http en el servidor y rellenar con valores reales (ese fichero
# está en .gitignore/.dockerignore, no se versiona).
#==============================================================================

#------------------------------------------------------------------------------
# http_service (Nginx).
# Sustituida por envsubst en nginx/conf.template y conf.bootstrap.template
# (${DOMAIN}) para server_name y las rutas del certificado Let's Encrypt.
# Debe coincidir exactamente con el mismo valor de DOMAIN en .env-prod-ahtrc.
DOMAIN=
