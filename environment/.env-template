# Plantilla, sin secretos, para environment/.env-local (entorno de
# desarrollo del devcontainer, docker-compose.local.yml, un único servicio
# ahtrc_service). Copiar a .env-local y rellenar con valores reales.
#
# Para producción (docker-compose.prod.yml) no se usa este fichero: cada
# servicio tiene su propia plantilla, sin secretos, ya dividida:
#   .env-prod-ahtrc-template -> environment/.env-prod-ahtrc (ahtrc_service)
#   .env-prod-db-template    -> environment/.env-prod-db    (postgres_service)
#   .env-prod-http-template  -> environment/.env-prod-http  (http_service)
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_HEADER_NAME=
SITE_INDEX_TITLE=
DEBUG=True
SECRET_KEY=

#Base de datos.
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
