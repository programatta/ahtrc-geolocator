ALLOWED_HOSTS=localhost,127.0.0.1
DOMAIN=
SITE_HEADER_NAME=
SITE_INDEX_TITLE=
DEBUG=
SECRET_KEY=

ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=

#Base de datos.
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Variables que usa la imagen postgis/postgis para inicializar la BD
# (postgres_service en docker-compose.prod.yml). Deben coincidir con
# DB_NAME/DB_USER/DB_PASSWORD.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Opcionales, con defaults seguros en conf/settings.py (solo aplican cuando
# DEBUG=False). Tocar solo si hace falta ajustar el comportamiento HTTPS:
# SECURE_HSTS_SECONDS=86400
# SECURE_HSTS_PRELOAD=False
# SECURE_SSL_REDIRECT=True   # poner a False solo durante el bootstrap de certbot (ver runbook nginx/certbot)
