server {
    listen 80;
    server_name ${DOMAIN};

    # No revelar la versión de nginx en la cabecera "Server"/páginas de error.
    server_tokens off;

    # Ruta necesaria para que Certbot valide la propiedad del dominio y
    # pueda emitir el primer certificado (todavía no existe ninguno).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Cabeceras de seguridad para /static/ y /media/, que nginx sirve
    # directamente sin pasar por Django. Sin Strict-Transport-Security aquí:
    # esta plantilla solo se usa en el arranque en HTTP puro (antes de tener
    # certificado), y los navegadores ignoran esa cabecera fuera de HTTPS.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Content-Security-Policy en modo Report-Only: ver el comentario
    # equivalente en conf.template y docs/DEUDA.md (2026-09-15,
    # Infraestructura/producción) para el detalle de cada origen permitido.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org https://tile.openstreetmap.org; connect-src 'self' https://nominatim.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

    # Archivos Estáticos y Media de Django
    location /static/ {
        alias /code/staticfiles/;
    }

    location /media/ {
        alias /code/media/;
    }

    # Proxy inverso hacia el contenedor de Django (Gunicorn)
    location / {
        proxy_pass http://ahtrc_service:8000;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_redirect off;
    }
}
