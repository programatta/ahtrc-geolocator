server {
    listen 80;
    server_name ${DOMAIN};

    # No revelar la versión de nginx en la cabecera "Server"/páginas de error.
    server_tokens off;

    # Ruta necesaria para que Certbot valide la propiedad del dominio
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirección de HTTP a HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    server_tokens off;

    # Certificados SSL de Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Optimización de seguridad SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Cabeceras de seguridad para /static/ y /media/, que nginx sirve
    # directamente sin pasar por Django (que ya las pone en sus propias
    # respuestas vía SecurityMiddleware/XFrameOptionsMiddleware). Mismo valor
    # de Referrer-Policy que conf/settings.py (SECURE_REFERRER_POLICY) y de
    # HSTS que SECURE_HSTS_SECONDS/SECURE_HSTS_INCLUDE_SUBDOMAINS (por
    # defecto en .env-prod-ahtrc) — si cambian esos valores, actualizar aquí
    # también.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=86400; includeSubDomains" always;

    # Content-Security-Policy en modo Report-Only (todavía no bloquea nada,
    # solo reporta violaciones en la consola del navegador): paso previo
    # antes de pasar a la cabecera "Content-Security-Policy" que sí bloquea,
    # una vez verificado en real que no falta ningún origen (mapa público y
    # admin, incluida la búsqueda del geocoder). 'unsafe-inline' en
    # script-src/style-src: necesario mientras home.html siga interpolando
    # los datos del mapa en un <script> inline en vez de usar json_script.
    # data: en img-src: lo usa el icono SVG embebido del buscador del
    # geocoder del admin (Control.Geocoder.css). *.tile.openstreetmap.org y
    # tile.openstreetmap.org (sin subdominio): el front usa tiles con
    # subdominios {s}=a/b/c, el widget de mapa del admin (django-leaflet) usa
    # el dominio sin subdominio — un wildcard no cubre el otro. Ver
    # docs/DEUDA.md (2026-09-15, Infraestructura/producción) para el diseño
    # completo.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org https://tile.openstreetmap.org; connect-src 'self' https://nominatim.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

    # Archivos Estáticos y Media de Django
    location /static/ {
        alias /code/staticfiles/;
    }

    location /media/ {
        alias /code/media/;
    }

    # Proxy inverso hacia el contenedor de Django (Gunicorn)
    location / {
        proxy_pass http://ahtrc_service:8000;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_redirect off;
    }
}
